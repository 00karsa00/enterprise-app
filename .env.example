# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Enterprise App
VITE_APP_VERSION=1.0.0

# ─── API ─────────────────────────────────────────────────────────────────────
# Must be a full URL including /api
VITE_API_BASE_URL=https://api.yourcompany.com/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY_MS=1000

# ─── Authentication ───────────────────────────────────────────────────────────
# Options: jwt | oauth | keycloak | firebase
VITE_AUTH_PROVIDER=jwt
VITE_AUTH_TOKEN_KEY=auth_token
VITE_AUTH_REFRESH_TOKEN_KEY=auth_refresh_token

# ─── Storage ──────────────────────────────────────────────────────────────────
VITE_STORAGE_PREFIX=enterprise_

# ─── Notifications ────────────────────────────────────────────────────────────
# Options: sonner | toastify
VITE_NOTIFICATION_PROVIDER=sonner
VITE_NOTIFICATION_DURATION=4000

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: debug | info | warn | error | fatal
VITE_LOG_LEVEL=info
# Options: console | sentry | datadog | azure
VITE_LOG_PROVIDER=console

# ─── Analytics ────────────────────────────────────────────────────────────────
# Options: none | google | mixpanel | amplitude
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_KEY=

# ─── Error Tracking ───────────────────────────────────────────────────────────
VITE_SENTRY_DSN=

# ─── Feature Flags ────────────────────────────────────────────────────────────
VITE_FEATURE_FLAGS_ENABLED=false
VITE_MAINTENANCE_MODE=false
